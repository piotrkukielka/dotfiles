# Atuin owns interactive history search (including Ctrl-R). It replaces the
# previous fzf bindings; fd remains available for tools such as Telescope.
eval "$(atuin init zsh)"

# zsh-autosuggest
ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=20
# zvm_after_init_commands+=("bindkey '^n' autosuggest-accept")
zvm_after_init_commands+=("bindkey '^e' forward-word")

function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
	rm -f -- "$tmp"
}

# setting up node.js
# . /usr/share/nvm/init-nvm.sh # seems to take a long time to load :/ maybe use https://github.com/lukechilds/zsh-nvm
PATH="$HOME/.local/bin:$PATH"
export PATH="${KREW_ROOT:-$HOME/.krew}/bin:$PATH"
