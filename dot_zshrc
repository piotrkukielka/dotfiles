# `p10k configure` writes this file outside the XDG config directory. Do not
# load it on the Linux console: its powerline glyphs require a Nerd Font.
if [[ "$TERM" != "linux" && -f ~/.p10k.zsh ]]; then
  source ~/.p10k.zsh
fi
