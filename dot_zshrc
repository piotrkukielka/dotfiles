# timing zsh startup
timezsh() {
  shell=${1-$SHELL}
  for i in $(seq 1 10); do time $shell -i -c exit; done
}

# eval $(thefuck --alias)   # EXTREMELY SLOW! +300ms!
eval "$(zoxide init zsh)"

# eval "$(zellij setup --generate-auto-start zsh)"
